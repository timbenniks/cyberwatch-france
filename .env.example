# Copy to `.env` for local overrides. On Vercel, set the same names as
# project environment variables — they are read at build time.

# Canonical and og: URLs baked into prerendered HTML.
# Without this, the build uses Vercel’s production URL, then localhost.
NUXT_PUBLIC_SITE_URL=https://your-domain.example

# Plausible site domain as registered in the dashboard (not a secret).
# Leave empty to keep analytics off. Required to enable tracking.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional. Only if you self-host Plausible (default: https://plausible.io).
# NUXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io
